---
layout: null
---
[
{% for p in site.html_pages %}
  {
    "title": {{ p.title | default: p.name | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "lang": {{ p.lang | default: "en" | jsonify }},
    "content": {{ p.content | strip_html | strip_newlines | replace: "  ", " " | truncate: 4000 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
